<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="NovaWeb is a responsive student landing page built with HTML and CSS.">

    <title>NovaWeb | Responsive Landing Page</title>

    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="site-header">
        <a href="#home" class="logo">NovaWeb</a>

        <nav aria-label="Main navigation">
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <section class="hero" id="home">

            <div class="hero-content">
                <p class="eyebrow">WELCOME TO NOVAWEB</p>

                <h1>Build Better Digital Experiences</h1>

                <p>
                    Discover clean design, responsive layouts,
                    and modern web development.
                    Start creating your digital future today.
                </p>

                <div class="hero-actions">
                    <a href="#services" class="button primary-button">
                        Explore Services
                    </a>

                    <a href="#about" class="button secondary-button">
                        Learn More
                    </a>
                </div>
            </div>

            <div class="hero-visual" aria-label="Laptop illustration">
                <span aria-hidden="true">💻</span>
            </div>

        </section>

        <section class="services section" id="services">
            <div class="section-heading">
                <p class="eyebrow">WHAT WE DO</p>
                <h2>Our Services</h2>
                <p>Simple solutions for building better websites.</p>
            </div>

            <div class="service-grid">

                <article class="service-card">
                    <div class="service-icon" aria-hidden="true">🎨</div>
                    <h3>Web Design</h3>
                    <p>
                        Create attractive and easy-to-use website layouts
                        with consistent colours and typography.
                    </p>
                </article>

                <article class="service-card">
                    <div class="service-icon" aria-hidden="true">💻</div>
                    <h3>Development</h3>
                    <p>
                        Build structured web pages using HTML and
                        style them with modern CSS.
                    </p>
                </article>

                <article class="service-card">
                    <div class="service-icon" aria-hidden="true">📱</div>
                    <h3>Responsive Design</h3>
                    <p>
                        Make layouts adapt to desktop, tablet,
                        and mobile screen sizes.
                    </p>
                </article>

            </div>
        </section>

        <section class="about section" id="about">
            <div>
                <p class="eyebrow">ABOUT THE PROJECT</p>
                <h2>Designed for Every Screen</h2>
            </div>

            <p>
                NovaWeb is a student project created to demonstrate
                semantic HTML, CSS Grid, Flexbox, responsive breakpoints,
                and reusable design variables.
            </p>
        </section>

        <section class="contact section" id="contact">
            <h2>Let's Connect</h2>

            <p>
                Thank you for visiting my responsive landing page.
            </p>

            <a href="mailto:student@example.com" class="button primary-button">
                Contact Me
            </a>
        </section>
    </main>

    <footer class="site-footer">
        <p>NovaWeb | HTML & CSS Practical Assignment 45</p>
        <p>Created for learning and practice.</p>
    </footer>

</body>
</html>